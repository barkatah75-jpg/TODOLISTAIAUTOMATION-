# AIVANA Kids OS production env for Hostinger
# Set these in Hostinger Node.js app environment variables.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://barkataiautomation.in
NEXT_PUBLIC_APP_NAME=AIVANA Kids OS

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-openai-key

RAZORPAY_KEY_ID=rzp_live_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=AIVANA Kids OS <noreply@barkataiautomation.in>

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@barkataiautomation.in

GOOGLE_VISION_API_KEY=your-google-vision-key

SUPABASE_STORAGE_BUCKET_DRAWINGS=drawings
SUPABASE_STORAGE_BUCKET_FILES=files
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

CRON_SECRET=your-strong-random-cron-secret
