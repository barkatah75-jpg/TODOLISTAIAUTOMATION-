# ============================================
# AIVANA Kids OS — Environment Variables
# Copy this file to .env.local for development
# ============================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AIVANA Kids OS"
NODE_ENV=development

# ── Supabase ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI (Claude / OpenAI) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-openai-key       # fallback

# ── Payments ─────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key

# PayPal (Global)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@aivana.app

# ── Rate Limiting (Upstash Redis) ────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ── Push Notifications (VAPID) ───────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@aivana.app

# ── Google Vision API (OCR - optional) ───────
GOOGLE_VISION_API_KEY=your-google-vision-key

# ── Storage ──────────────────────────────────
SUPABASE_STORAGE_BUCKET_DRAWINGS=drawings
SUPABASE_STORAGE_BUCKET_FILES=files
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# ── Webhook Secrets ────────────────────────────────────────────────────────────
# Set this in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
